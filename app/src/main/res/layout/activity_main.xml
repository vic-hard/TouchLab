<?xml version="1.0" encoding="utf-8"?>
<!--
  Минимальный хост для проверки коллектора: поле participant_id, управление сессией,
  область TAP и техническая сводка. Полный интерфейс раздела 12 — блок 2.

  Область касания отделена от краёв экрана: §5.1 требует безопасного отступа, иначе
  системные краевые жесты перехватывают поток и попытки закрываются как CANCEL.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/participant_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/participant_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:text="@string/participant_default" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/start_session"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/start_session" />

        <Button
            android:id="@+id/finish_session"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/finish_session" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:textSize="12sp" />

    <com.lime.touchlab.TapAreaView
        android:id="@+id/tap_area"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="24dp"
        android:layout_weight="1" />

</LinearLayout>
